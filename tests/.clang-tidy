# Tests inherit the workspace configuration (coding-style.md section 19), with these exceptions:
#   readability-magic-numbers           expected values in assertions are the data under test; naming each obscures it
#   bugprone-unchecked-optional-access  accesses are guarded by gtest ASSERT_* macros, which the dataflow analysis cannot
#                                       see through; debug builds define _GLIBCXX_ASSERTIONS, so a bad access aborts
InheritParentConfig: true
Checks: >
  -readability-magic-numbers,
  -bugprone-unchecked-optional-access
